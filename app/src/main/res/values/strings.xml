<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CMP composeResources는 AndroidManifest.xml의 @string/ 참조를 해석하지 못하고
         (composeResources는 별도 asset 기반 리소스 시스템이라 일반 Android AAPT 파이프라인과
         분리돼 있다), Android 시스템 API(NotificationChannel 등)도 마찬가지로 진짜 Android
         리소스 ID를 요구해 CMP StringResource를 못 받는다 — 이 두 문자열은 그래서 여기 남아있다.
         나머지 374개 문자열은 shared/src/commonMain/composeResources/values/strings.xml로
         이동했다. -->
    <string name="app_name">Pickii</string>
    <!-- FcmService.onCreate()의 NotificationChannel 이름. Service#getString(Int)로 동기 조회해야
         해서 CMP의 suspend getString(StringResource)을 쓸 수 없다. -->
    <string name="general_notification_channel_name">일반 알림</string>
</resources>
